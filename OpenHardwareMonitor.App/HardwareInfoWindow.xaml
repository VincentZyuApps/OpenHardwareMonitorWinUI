<winuiex:WindowEx
    x:Class="OpenHardwareMonitor.App.HardwareInfoWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:winuiex="using:WinUIEx"
    Title="硬件信息"
    MinWidth="420"
    MinHeight="360">
    <Grid x:Name="RootGrid" Padding="16" Background="{ThemeResource AppBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" Background="{ThemeResource AccentFillColorSecondaryBrush}" CornerRadius="4">
                        <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20" Glyph="&#xE950;" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontFamily="Segoe UI Variable Display" FontSize="20" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" FontSize="12" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="3">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="标识" />
                    <TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" Text="{Binding Id}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="属性" />
                    <Border Background="{ThemeResource AppSurfaceBrush}" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6">
                        <controls:ItemsRepeater ItemsSource="{Binding Properties}">
                            <controls:ItemsRepeater.Layout>
                                <controls:StackLayout Spacing="0" />
                            </controls:ItemsRepeater.Layout>
                            <controls:ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="28" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{Binding Key}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource AppSecondaryTextBrush}" FontSize="12" IsTextSelectionEnabled="True" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </controls:ItemsRepeater.ItemTemplate>
                        </controls:ItemsRepeater>
                    </Border>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="硬件报告" />
                    <Button Grid.Column="1" MinWidth="82" Click="CopyReport_Click" ToolTipService.ToolTip="复制完整硬件报告">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <SymbolIcon Symbol="Copy" />
                            <TextBlock x:Name="CopyButtonLabel" Text="复制" />
                        </StackPanel>
                    </Button>
                </Grid>
                <TextBox MinHeight="180" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsReadOnly="True" IsSpellCheckEnabled="False" AcceptsReturn="True" Text="{Binding Report}" TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</winuiex:WindowEx>
