<winuiex:WindowEx
    x:Class="OpenHardwareMonitor.App.GadgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:winuiex="using:WinUIEx"
    Title="Open Hardware Monitor">
    <Grid x:Name="RootGrid" Background="{ThemeResource AppSurfaceBrush}" Padding="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" Text="硬件状态" /><Button Grid.Column="1" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0" Click="Close_Click" ToolTipService.ToolTip="关闭悬浮窗"><SymbolIcon Symbol="Cancel" /></Button></Grid>
        <controls:ItemsRepeater Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding DashboardMetrics}">
            <controls:ItemsRepeater.Layout><controls:StackLayout Spacing="8" /></controls:ItemsRepeater.Layout>
            <controls:ItemsRepeater.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Foreground="{ThemeResource AppSecondaryTextBrush}" Text="{Binding Title}" /><TextBlock Grid.Column="1" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" Text="{Binding Value}" /></Grid></DataTemplate></controls:ItemsRepeater.ItemTemplate>
        </controls:ItemsRepeater>
    </Grid>
</winuiex:WindowEx>
