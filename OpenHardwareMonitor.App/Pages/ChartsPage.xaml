<Page
    x:Class="OpenHardwareMonitor.App.Pages.ChartsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:chart="using:OpenHardwareMonitor.App.Controls"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Style="{StaticResource PageRootStyle}">
            <StackPanel Spacing="4"><TextBlock Style="{StaticResource PageTitleStyle}" Text="图表" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="展示已选传感器最近六分钟的内存历史。数据每次刷新后更新。" /></StackPanel>
            <Border Style="{StaticResource SurfaceStyle}" Padding="12">
                <Expander Header="选择传感器" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="24" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,16,0" Padding="6,0" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="76" />
                                <ColumnDefinition Width="112" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="传感器" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="硬件" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="类型" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="当前" />
                        </Grid>
                        <ListView Grid.Row="1" MaxHeight="260" HorizontalAlignment="Stretch" ItemsSource="{Binding ChartCandidates}" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="MinHeight" Value="28" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="28" Margin="0,0,16,0" Padding="6,0" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,0,0,1" ColumnSpacing="10" ToolTipService.ToolTip="{Binding FullName}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="1.1*" />
                                            <ColumnDefinition Width="1.6*" />
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="112" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Width="24" Height="24" MinHeight="0" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="{Binding FullName}" Tag="{Binding SensorId}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Click="ChartSelection_Click" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="13" Text="{Binding SensorName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="{Binding HardwareName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource AppSecondaryTextBrush}" Text="{Binding TypeLabel}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="12" FontFamily="Segoe UI Variable Text" Text="{Binding ValueText}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Expander>
            </Border>
            <controls:ItemsRepeater ItemsSource="{Binding ChartSeries}">
                <controls:ItemsRepeater.Layout><controls:StackLayout Spacing="12" /></controls:ItemsRepeater.Layout>
                <controls:ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource SurfaceStyle}" Padding="16">
                            <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="56" /></Grid.RowDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" FontFamily="Segoe UI Variable Display" FontWeight="SemiBold" Text="{Binding ValueText}" /></Grid>
                                <chart:HistorySparkline Grid.Row="1" Points="{Binding Points}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </controls:ItemsRepeater.ItemTemplate>
            </controls:ItemsRepeater>
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="可同时显示最多八条曲线。选择会保存到当前配置。" />
        </StackPanel>
    </ScrollViewer>
</Page>
