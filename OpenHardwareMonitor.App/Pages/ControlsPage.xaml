<Page
    x:Class="OpenHardwareMonitor.App.Pages.ControlsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="28,22,28,28" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Spacing="4"><TextBlock Style="{StaticResource PageTitleStyle}" Text="控制" /><TextBlock Style="{StaticResource SecondaryTextStyle}" Text="仅显示硬件库提供软件控制通道的设备。应用手动值前请确认主板或设备支持。" /></StackPanel>
        <ListView Grid.Row="1" ItemsSource="{Binding ControlRows}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource SurfaceStyle}" Margin="0,0,0,10" Padding="16">
                        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Spacing="3"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" /><TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="12" Text="{Binding HardwareName}" /><TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="12" Text="{Binding CurrentValue}" /></StackPanel>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding PendingValue, Mode=TwoWay}" VerticalAlignment="Center" />
                            <Button Grid.Column="2" VerticalAlignment="Center" Click="Apply_Click"><StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Accept" /><TextBlock Text="应用" /></StackPanel></Button>
                            <Button Grid.Column="3" VerticalAlignment="Center" Click="Default_Click"><StackPanel Orientation="Horizontal" Spacing="6"><SymbolIcon Symbol="Refresh" /><TextBlock Text="自动" /></StackPanel></Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
