<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="OpenHardwareMonitor.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F7F7F7" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="AppSurfaceSubtleBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#616161" />
                    <SolidColorBrush x:Key="AppHeaderBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#F3F3F3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#202020" />
                    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#2B2B2B" />
                    <SolidColorBrush x:Key="AppSurfaceSubtleBrush" Color="#292929" />
                    <SolidColorBrush x:Key="AppBorderBrush" Color="#424242" />
                    <SolidColorBrush x:Key="AppSecondaryTextBrush" Color="#B9B9B9" />
                    <SolidColorBrush x:Key="AppHeaderBrush" Color="#202020" />
                    <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="#202020" />
                    <SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="#202020" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PageRootStyle" TargetType="StackPanel">
                <Setter Property="Padding" Value="28,22,28,28" />
                <Setter Property="Spacing" Value="18" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource AppSecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SurfaceStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource AppSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource AppBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
